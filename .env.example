# Copy this file to .env and fill it in. Missing required values are asked for at startup.

# --- required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram chat id the bot talks to
TELEGRAM_CHAT_ID=
# Frame difference at or above which an alarm is sent, e.g. 0.05
ALARM_THRESHOLD=0.05

# --- optional ---
# Camera to use when several are found; chosen and saved automatically on first run
# (run with -fetch-camera to choose again)
CAMERA_ID=
# Serve the live difference graph at http://localhost:8080 (1 or true to enable)
LIVE_STREAM_GRAPH=false
# Print the frame difference of every frame to the console
PRINT_DIFFERENCES=false
# Print every Telegram message received from the chat to the console
PRINT_TELEGRAM_MESSAGES=false
