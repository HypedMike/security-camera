# Copy this file to .env and fill it in. Missing required values are asked for at startup.

# --- required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram chat id the bot talks to
TELEGRAM_CHAT_ID=

# --- optional ---
# Motion detector: background (default) or difference; /detector switches it at runtime
DETECTOR=background
# Alarm threshold of the background detector: area of the largest moving blob
# as a fraction of the frame (0 to 1), e.g. 0.003
BACKGROUND_THRESHOLD=0.003
# Alarm threshold of the difference detector: average change between
# consecutive frames (0 to 1), e.g. 0.05. ALARM_THRESHOLD is still read if this is unset.
DIFFERENCE_THRESHOLD=0.05
# Camera to use when several are found; chosen and saved automatically on first run
# (run with -fetch-camera to choose again)
CAMERA_ID=
# Serve the live motion score graph at http://localhost:8080 (1 or true to enable)
LIVE_STREAM_GRAPH=false
# Print the motion score of every frame to the console
PRINT_DIFFERENCES=false
# Print a line to the console whenever an alarm is set off
PRINT_ALARMS=false
# Print every Telegram message received from the chat to the console
PRINT_TELEGRAM_MESSAGES=false
# Coordinates for the weather in the daily 9:00 message (decimal degrees, e.g.
# 45.46 and 9.19 for Milan). Left empty, it uses Lucca (43.843, 10.5027).
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
