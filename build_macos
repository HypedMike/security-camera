#!/usr/bin/env bash
# Builds the security camera on macOS: a single Rust binary, ./securitycamera.
set -euo pipefail
cd "$(dirname "$0")"

if [ "$(uname -s)" != "Darwin" ]; then
	echo "build_macos must run on macOS" >&2
	exit 1
fi

# Rust (https://rustup.rs) and the Xcode command line tools, for the C linker
if ! command -v cargo >/dev/null; then
	echo "cargo not found: install Rust from https://rustup.rs" >&2
	exit 1
fi
if ! xcode-select -p >/dev/null 2>&1; then
	echo "the Xcode command line tools are missing, run: xcode-select --install" >&2
	exit 1
fi

(cd lib && cargo build --release -p securitycamera)

cp lib/target/release/securitycamera securitycamera.new
mv -f securitycamera.new securitycamera
echo "built ./securitycamera"
