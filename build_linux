#!/usr/bin/env bash
# Builds the security camera on Linux: a single Rust binary, ./securitycamera.
set -euo pipefail
cd "$(dirname "$0")"

if [ "$(uname -s)" != "Linux" ]; then
	echo "build_linux must run on Linux" >&2
	exit 1
fi
if ! command -v cargo >/dev/null; then
	echo "cargo not found: install Rust from https://rustup.rs" >&2
	exit 1
fi
if ! command -v gcc >/dev/null || [ ! -f /usr/include/linux/videodev2.h ]; then
	echo "missing C toolchain, run: sudo apt install build-essential linux-libc-dev" >&2
	exit 1
fi

(cd lib && cargo build --release -p securitycamera)

# copy to a new name and rename it: the old binary may be running, and a
# running program can't be written to, but it can be replaced
cp lib/target/release/securitycamera securitycamera.new
mv -f securitycamera.new securitycamera
echo "built ./securitycamera"
